<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>本人確認書類の提出</title>
<style>
  :root { --main:#1f4e79; --line:#d0d7de; --bg:#f6f8fa; --err:#c62828; --ok:#2e7d32; }
  * { box-sizing:border-box; }
  body { margin:0; font-family:"Hiragino Sans","Noto Sans JP","Yu Gothic",sans-serif; background:var(--bg); color:#222; line-height:1.7; }
  .wrap { max-width:640px; margin:0 auto; padding:16px 16px 48px; }
  h1 { font-size:20px; color:var(--main); margin:8px 0 4px; }
  .lead { font-size:13px; color:#555; margin:0 0 16px; }
  .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px; margin-bottom:16px; }
  .card h2 { font-size:16px; margin:0 0 8px; color:var(--main); }
  label.f { display:block; font-size:14px; font-weight:600; margin:12px 0 4px; }
  .req::after { content:"必須"; font-size:11px; color:#fff; background:var(--err); border-radius:3px; padding:0 5px; margin-left:6px; font-weight:normal; }
  .opt::after { content:"任意"; font-size:11px; color:#fff; background:#888; border-radius:3px; padding:0 5px; margin-left:6px; font-weight:normal; }
  input[type=text], input[type=email], select { width:100%; padding:10px; font-size:16px; border:1px solid var(--line); border-radius:6px; background:#fff; }
  .row { display:flex; gap:8px; align-items:flex-start; }
  .row > .grow { flex:1; min-width:0; }
  button { font-size:15px; padding:10px 14px; border:none; border-radius:6px; cursor:pointer; }
  .btn-main { background:var(--main); color:#fff; width:100%; font-size:17px; padding:14px; }
  .btn-sub { background:#e7edf3; color:var(--main); white-space:nowrap; }
  button:disabled { opacity:.5; cursor:not-allowed; }
  .check { display:flex; gap:6px; align-items:flex-start; font-weight:normal; font-size:15px; }
  .check input { width:20px; height:20px; margin-top:3px; flex:0 0 auto; }
  .hint { font-size:12px; color:#666; margin-top:4px; }
  .msg { font-size:13px; margin-top:4px; min-height:1em; }
  .msg.ok { color:var(--ok); } .msg.err { color:var(--err); }
  .notice { background:#fff8e1; border:1px solid #ffe082; border-radius:6px; padding:10px; font-size:13px; margin-top:10px; }
  #sigPad { width:100%; height:170px; border:2px dashed var(--line); border-radius:6px; touch-action:none; background:#fff; display:block; }
  .done { text-align:center; padding:32px 16px; }
  .done .no { font-size:20px; font-weight:700; color:var(--main); margin:12px 0; }
  .hidden { display:none; }
  .overlay { position:fixed; inset:0; background:rgba(255,255,255,.85); display:none; align-items:center; justify-content:center; flex-direction:column; z-index:999; font-size:15px; color:#1f4e79; text-align:center; padding:24px; }
  .overlay.show { display:flex; }
  .spinner { width:42px; height:42px; border:4px solid #d0d7de; border-top-color:#1f4e79; border-radius:50%; animation:spin 1s linear infinite; margin-bottom:14px; }
  @keyframes spin { to { transform:rotate(360deg); } }
  .bd select { padding:10px 6px; }
  .radios { display:flex; gap:16px; flex-wrap:wrap; }
  .radios label { display:flex; gap:6px; align-items:flex-start; font-weight:normal; font-size:15px; }
  .radios input { width:20px; height:20px; margin-top:3px; flex:0 0 auto; }
  .ph { margin-top:6px; }
  .ph input[type=file] { position:absolute; width:1px; height:1px; opacity:0; pointer-events:none; }
  .ph-btn { display:inline-block; background:#e7edf3; color:var(--main); border-radius:6px; padding:10px 14px; font-size:15px; cursor:pointer; font-weight:600; }
  .ph-prev { margin-top:8px; }
  .ph-prev img { max-width:100%; max-height:220px; border-radius:6px; border:1px solid var(--line); display:block; }
  .ph-prev .ph-meta { font-size:12px; color:var(--ok); margin-top:4px; }
  .ph-prev .ph-meta.err { color:var(--err); }
</style>
</head>
<body>
<div class="wrap">
<div id="formArea">
  <h1>本人確認書類の提出</h1>
  <p class="lead"><span data-c="COMPANY_NAME"></span>への本人確認書類（顔写真・身分証）の提出ページです。入社手続きフォームで登録した氏名・生年月日・メールアドレスで本人確認をします。</p>

  <!-- 1 本人確認 -->
  <div class="card" id="idCard">
    <h2>1. 本人確認</h2>
    <label class="f req">氏名</label>
    <input type="text" id="name" placeholder="例：山田太郎" autocomplete="name">
    <label class="f req">生年月日</label>
    <div class="row bd"><select id="bY" class="grow"><option value="">年</option></select><select id="bM" class="grow"><option value="">月</option></select><select id="bD" class="grow"><option value="">日</option></select></div>
    <label class="f req">メールアドレス（入社フォームで登録したもの）</label>
    <div class="row">
      <input type="email" id="email" class="grow" placeholder="example@mail.com" autocomplete="email">
      <button type="button" class="btn-sub" id="sendCodeBtn">認証コード送信</button>
    </div>
    <div class="msg" id="codeMsg"></div>
    <label class="f req">認証コード（6桁）</label>
    <input type="text" id="code" inputmode="numeric" maxlength="6" placeholder="メールに届いた6桁の数字">
    <div class="msg err" id="loadMsg"></div>
    <button type="button" class="btn-main" id="loadBtn" style="margin-top:8px">次へ</button>
  </div>

  <div id="phArea" class="hidden">
    <div class="card">
      <h2>2. 顔写真・身分証 <small id="who" style="font-weight:normal;color:#666;font-size:12px"></small></h2>
      <label class="f req">顔写真</label>
      <div class="hint">正面を向いて、顔がはっきり写るように撮影してください（帽子・マスク・サングラスは外してください）。</div>
      <div class="ph" id="ph-face"><input type="file" accept="image/*" id="idFaceFile"><label for="idFaceFile" class="ph-btn">📷 顔写真を撮る・選ぶ</label><div class="ph-prev"></div></div>

      <label class="f req">身分証の種類</label>
      <div class="radios">
        <label><input type="radio" name="idType" value="運転免許証">運転免許証</label>
        <label><input type="radio" name="idType" value="マイナンバーカード">マイナンバーカード</label>
        <label><input type="radio" name="idType" value="健康保険証・資格確認書">健康保険証・資格確認書</label>
      </div>
      <div class="notice hidden" id="idNote"></div>

      <label class="f req">身分証（表面）</label>
      <div class="ph" id="ph-front"><input type="file" accept="image/*" id="idFrontFile"><label for="idFrontFile" class="ph-btn">📷 表面を撮る・選ぶ</label><div class="ph-prev"></div></div>
      <label class="f opt">身分証（裏面）</label>
      <div class="ph" id="ph-back"><input type="file" accept="image/*" id="idBackFile"><label for="idBackFile" class="ph-btn">📷 裏面を撮る・選ぶ</label><div class="ph-prev"></div></div>
      <div class="hint">明るい場所で、4つの角が入るように、文字が読めるように撮影してください。光の反射にご注意ください。</div>
    </div>
    <div class="msg err" id="submitMsg"></div>
    <button type="button" class="btn-main" id="submitBtn">提出する</button>
  </div>
</div>

<div id="doneArea" class="card done hidden">
  <h1>提出が完了しました</h1>
  <div>受付番号</div>
  <div class="no" id="receiptNo"></div>
  <p>本人確認書類を受け付けました。控えをメールでお送りしました。<br>不備がある場合は、担当者からご連絡します。</p>
</div>
</div>

<script src="config.js"></script>
<script>
  /* ===== GAS（裏側）との通信 ===== */
  (function () {
    const C = window.FORM_CONFIG || {};
    const params = new URLSearchParams(location.search);
    function api(fn, args) {
      return fetch(C.API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ fn: fn, args: args, k: params.get('k') || '' }) })
        .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
    }
    window.google = { script: {} };
    Object.defineProperty(window.google.script, 'run', { get: function () {
      const st = {};
      const p = new Proxy({}, { get: function (_, k) {
        if (k === 'withSuccessHandler') return f => { st.s = f; return p; };
        if (k === 'withFailureHandler') return f => { st.f = f; return p; };
        return (...args) => api(k, args).then(r => { try { st.s && st.s(r); } catch (e) { console.error(e); } }, e => { console.error(e); st.f && st.f(e); });
      } });
      return p;
    } });
    document.addEventListener('DOMContentLoaded', () => { document.querySelectorAll('[data-c]').forEach(el => { el.textContent = C[el.getAttribute('data-c')] || ''; }); });
  })();
</script>
<script>
  const $ = id => document.getElementById(id);

  /* ---------- 生年月日 ---------- */
  function wareki(y) { return y >= 2019 ? '令和' + (y - 2018) : y >= 1989 ? '平成' + (y - 1988) : '昭和' + (y - 1925); }
  (function initBirth() {
    const y = $('bY'), m = $('bM'), d = $('bD'), now = new Date().getFullYear();
    for (let i = now - 15; i >= now - 80; i--) y.add(new Option(i + '年（' + wareki(i) + '）', i));
    for (let i = 1; i <= 12; i++) m.add(new Option(i + '月', i));
    const fill = () => { const cur = Number(d.value), n = y.value && m.value ? new Date(y.value, m.value, 0).getDate() : 31; d.length = 1; for (let i = 1; i <= n; i++) d.add(new Option(i + '日', i)); if (cur && cur <= n) d.value = cur; };
    fill(); ['change', 'input'].forEach(ev => { y.addEventListener(ev, fill); m.addEventListener(ev, fill); });
  })();
  const getBirth = () => { const y = $('bY').value, m = $('bM').value, d = $('bD').value; return y && m && d ? y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0') : ''; };

  /* ---------- 認証コード ---------- */
  function cooldown(btn, sec) {
    btn.disabled = true;
    const t = setInterval(() => { sec--; btn.textContent = '再送信（' + sec + '）'; if (sec <= 0) { clearInterval(t); btn.disabled = false; btn.textContent = '再送信'; } }, 1000);
    btn.textContent = '再送信（' + sec + '）';
  }
  $('sendCodeBtn').onclick = () => {
    const btn = $('sendCodeBtn'), msg = $('codeMsg');
    btn.disabled = true; msg.className = 'msg'; msg.textContent = '送信中…';
    google.script.run.withSuccessHandler(r => {
      msg.className = r.ok ? 'msg ok' : 'msg err';
      msg.textContent = r.ok ? '認証コードを送信しました。メールをご確認ください（10分間有効）。' : r.message;
      if (r.ok) cooldown(btn, 30); else btn.disabled = false;
    }).withFailureHandler(() => { msg.className = 'msg err'; msg.textContent = '送信に失敗しました。'; btn.disabled = false; })
      .sendVerificationCode($('email').value, 'id');
  };

  /* ---------- 名簿と照合 ---------- */
  let TOKEN = '';
  $('loadBtn').onclick = () => {
    const msg = $('loadMsg'), btn = $('loadBtn');
    const q = { name: $('name').value, birth: getBirth(), email: $('email').value, code: $('code').value };
    if (!q.name.trim() || !q.birth || !q.email.trim()) { msg.textContent = '氏名・生年月日・メールアドレスを入力してください。'; return; }
    if (!q.code.trim()) { msg.textContent = 'メールに届いた認証コードを入力してください。'; return; }
    btn.disabled = true; btn.textContent = '確認しています…'; msg.textContent = '';
    google.script.run.withSuccessHandler(r => {
      btn.disabled = false; btn.textContent = '次へ';
      if (!r || !r.ok) { msg.textContent = (r && r.message) || 'エラーが発生しました。'; return; }
      TOKEN = r.token;
      $('who').textContent = '（' + r.name + ' さん）';
      $('idCard').classList.add('hidden'); $('phArea').classList.remove('hidden');
      window.scrollTo(0, 0);
    }).withFailureHandler(() => { btn.disabled = false; btn.textContent = '次へ'; msg.textContent = '通信エラーが発生しました。もう一度お試しください。'; })
      .loadContract(q);
  };

  /* ---------- 写真：縮小して保持 ---------- */
  const PHOTOS = { face: '', front: '', back: '' };
  function shrinkImage(file, maxSide, quality) {
    return new Promise((ok, ng) => {
      const url = URL.createObjectURL(file), img = new Image();
      img.onload = () => {
        const s = Math.min(1, maxSide / Math.max(img.naturalWidth, img.naturalHeight));
        const c = document.createElement('canvas');
        c.width = Math.round(img.naturalWidth * s); c.height = Math.round(img.naturalHeight * s);
        const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height); g.drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url); ok(c.toDataURL('image/jpeg', quality));
      };
      img.onerror = () => { URL.revokeObjectURL(url); ng(new Error('画像を読み込めませんでした。別の写真でお試しください。')); };
      img.src = url;
    });
  }
  [['face', 'idFaceFile', 'ph-face'], ['front', 'idFrontFile', 'ph-front'], ['back', 'idBackFile', 'ph-back']].forEach(([k, inp, box]) => {
    $(inp).addEventListener('change', async e => {
      const f = e.target.files && e.target.files[0], prev = $(box).querySelector('.ph-prev');
      if (!f) return;
      prev.innerHTML = '<div class="ph-meta">読み込み中…</div>';
      try {
        PHOTOS[k] = await shrinkImage(f, k === 'face' ? 1000 : 1600, 0.82);
        prev.innerHTML = '<img src="' + PHOTOS[k] + '" alt=""><div class="ph-meta">✓ 添付しました（撮り直す場合は、もう一度ボタンを押してください）</div>';
        $(box).querySelector('.ph-btn').textContent = '📷 撮り直す・選び直す';
      } catch (err) { PHOTOS[k] = ''; prev.innerHTML = '<div class="ph-meta err">' + err.message + '</div>'; }
    });
  });
  const ID_NOTES = {
    '運転免許証': '表面と裏面（住所変更などの記載がある場合）を撮影してください。',
    'マイナンバーカード': '表面（顔写真のある面）を撮影してください。裏面（マイナンバーが記載された面）は、マイナンバーの確認のため撮影してください。',
    '健康保険証・資格確認書': '撮影前に、記号・番号・保険者番号・QRコードの部分を付箋などで隠してください（法律で求められています）。顔写真がない書類のため、顔写真の撮影は必ず行ってください。',
  };
  document.querySelectorAll('input[name="idType"]').forEach(r => r.addEventListener('change', () => {
    $('idNote').textContent = ID_NOTES[r.value] || ''; $('idNote').classList.toggle('hidden', !ID_NOTES[r.value]);
  }));

  /* ---------- 提出 ---------- */
  const REQ_ID = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
  function recover(id, onOk, onNg, tries) {
    tries = tries || 0;
    const again = r => { if (tries < 6) setTimeout(() => recover(id, onOk, onNg, tries + 1), 3000); else onNg(r); };
    google.script.run.withSuccessHandler(r => { if (r && r.ok) onOk(r); else again(r); }).withFailureHandler(() => again(null)).getResult(id);
  }
  $('submitBtn').onclick = () => {
    const msg = $('submitMsg'), btn = $('submitBtn');
    const idType = (document.querySelector('input[name="idType"]:checked') || {}).value || '';
    if (!PHOTOS.face) { msg.textContent = '顔写真を撮影（または選択）してください。'; return; }
    if (!idType) { msg.textContent = '身分証の種類を選んでください。'; return; }
    if (!PHOTOS.front) { msg.textContent = '身分証（表面）の写真を撮影（または選択）してください。'; return; }
    btn.disabled = true; btn.textContent = '送信中…'; msg.textContent = ''; $('overlay').classList.add('show');
    const d = { token: TOKEN, idType: idType, idFace: PHOTOS.face, idFront: PHOTOS.front, idBack: PHOTOS.back, requestId: REQ_ID };
    const showDone = r => {
      $('overlay').classList.remove('show');
      $('formArea').classList.add('hidden'); $('doneArea').classList.remove('hidden');
      $('receiptNo').textContent = r.receiptNo || ''; window.scrollTo(0, 0);
    };
    const showFail = t => { $('overlay').classList.remove('show'); msg.textContent = t; btn.disabled = false; btn.textContent = '提出する'; };
    const later = () => recover(REQ_ID, showDone, () => showFail('送信結果を確認できませんでした。控えのメールが届いていれば提出は完了しています。届いていない場合は、もう一度「提出する」を押してください。'));
    google.script.run.withSuccessHandler(r => {
      if (r && r.ok) return showDone(r);
      if (r && r.pending) return later();
      showFail((r && r.message) || 'エラーが発生しました。');
    }).withFailureHandler(later).submitIdDocs(d);
  };

  document.addEventListener('change', e => { if (e.target && e.target.tagName === 'SELECT') setTimeout(() => e.target.blur(), 0); });
</script>
<div class="overlay" id="overlay"><div class="spinner"></div><div>送信しています。<br>画面を閉じずに、しばらくお待ちください。</div></div>
</body>
</html>
